# Keep the Gemini key only on this backend, never in Flutter.
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
SATHI_ALLOWED_ORIGINS=*
# Local-only hackathon backend. Never use this setting for a public deployment.
SATHI_ALLOW_UNAUTHENTICATED_DEV=true
